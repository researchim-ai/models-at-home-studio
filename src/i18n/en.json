  "docs.grpo_intro": "GRPO trains a policy by sampling a group of completions per prompt and optimizing towards higher-reward ones — no separate value model needed.",
  "docs.grpo_grpo": "the baseline algorithm, KL to a reference policy is optional",
  "docs.grpo_dr": "removes length/std bias for more stable training",
  "docs.grpo_dapo": "dynamic sampling with a higher clip range (~0.28)",
  "docs.grpo_sdpo": "self-distillation variant with a small KL term",
  "docs.grpo_tips": "Tips: start with group size 8, temperature 0.7-1.0, and a small LR (5e-6 full FT, 5e-5 LoRA).",
  "docs.lora_intro": "LoRA trains small low-rank adapters instead of full weights, saving VRAM. QLoRA adds 4-bit quantization of the base model.",
  "docs.lora_r": "adapter rank; higher = more capacity, more VRAM (8-64 typical)",
  "docs.lora_alpha": "scaling factor; often set equal to rank",
  "docs.lora_dropout": "regularization on adapters (0.0-0.1)",
  "docs.lora_modules": "which projections to adapt (q/k/v/o and MLP)",
  "docs.lora_tip": "For SFT, adapt all linear layers for best quality. For domain adaptation, q/v is often enough.",
  "docs.dist_single": "everything on one GPU; simplest, use gradient checkpointing if OOM",
  "docs.dist_ddp": "data-parallel replicas across GPUs, model fits on each GPU",
  "docs.dist_fsdp": "shards params/grads/optimizer across GPUs for large models",
  "docs.dist_deepspeed": "ZeRO-2 shards optimizer+grads; ZeRO-3 also shards params (+CPU offload)",
  "docs.opt_flash": "faster, memory-efficient attention",
  "docs.opt_gc": "recompute activations to save VRAM at the cost of compute",
  "docs.opt_liger": "fused Triton kernels for higher throughput and lower memory",
  "docs.opt_bf16": "half precision without loss scaling — the default on modern GPUs",
  "docs.opt_8bit": "8-bit Adam reduces optimizer state memory",
  "docs.tr_oom": "lower batch size, enable gradient checkpointing, use LoRA/QLoRA, reduce seq length",
  "docs.tr_loss_spike_t": "Loss spikes",
  "docs.tr_loss_spike": "lower LR, increase warmup, clip gradients (max_grad_norm)",
  "docs.tr_plateau_t": "Loss plateau",
  "docs.tr_plateau": "increase LR or data diversity, check the scheduler",
  "docs.tr_gibberish_t": "Model outputs gibberish",
  "docs.tr_gibberish": "check tokenizer/chat template, ensure enough training steps",
  "docs.tr_slow_t": "Training is slow",
